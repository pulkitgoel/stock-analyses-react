# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Staged deploy scaffolding. deploy.sh builds into dist.next and swaps it in via
# dist.previous, so these exist between builds and are ~29 MB of build output.
# Without them here they show up as untracked and invite an accidental `git add`.
dist.next
dist.previous
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python bytecode
__pycache__/
*.py[cod]

# SEO audit output: large (8.7MB of screenshots), not needed on the server
stocksfundamentals.online-audit/

# Discovery files, generated by scripts/generate-discovery-files.py on every
# build and copied into dist/ by Vite. Derived output, so not tracked:
# llms-full.txt alone is ~2.5MB and changes on every publish.
public/llms.txt
public/llms-full.txt
public/rss.xml
radar/prices/
radar/fundamentals/
